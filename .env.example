# Generated from scripts/config.env.json by scripts/env-sync.mjs.
# Copy to .env for local experimentation; never put credentials in this file.

# Optional application data directory override; blank uses the platform default.
LP_HOME=
# Optional verified tool installation directory.
LP_TOOLS_DIR=
# Daemon bind address; loopback is the safe native default.
LP_BIND=127.0.0.1
# Local daemon TCP port.
LP_PORT=4317
# Set to 1 only for the explicitly containerized runtime.
LP_IN_CONTAINER=0
# Structured log level.
LP_LOG_LEVEL=info
# Structured log format.
LP_LOG_FORMAT=json
# Default data-egress policy for later provider routing.
LP_DATA_POLICY=local_only
# Neutral daily hosted-spend cap in the configured currency.
LP_BUDGET_DAY=0
# Neutral project hosted-spend cap in the configured currency.
LP_BUDGET_PROJECT=0
# Optional path to a verified Godot executable.
LP_GODOT_BIN=
# Optional path to a verified Blender executable.
LP_BLENDER_BIN=
# Optional path to a verified ffmpeg executable.
LP_FFMPEG_BIN=
# Optional path to a verified llama-server executable.
LP_LLAMA_SERVER_BIN=
# Optional local ComfyUI endpoint; blank disables the route.
LP_COMFYUI_URL=
# Example provider secret; leave empty and use the OS keychain later.
LP_KEY_PROVIDER_EXAMPLE=
# Enable the offline test network guard.
LP_TEST_NETWORK_GUARD=1
# Opt in to tests requiring external agents or hosted providers.
LP_LIVE_TESTS=0
# Opt in to hardware qualification tests.
LP_HW_TESTS=0
