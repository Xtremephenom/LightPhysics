; Minimal deterministic Godot project for the Phase 0 smoke runner.
; The runner supplies the script entrypoint explicitly in headless mode.

config_version=5

[application]

config/name="LightPhysics Mini Game Fixture"

[display]

window/size/viewport_width=320
window/size/viewport_height=180

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
